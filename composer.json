{
    "name": "gboquizosanchez/phpstan-code-limits",
    "description": "PHPStan rules that enforce size, layout and expression limits on PHP code",
    "license": "MIT",
    "type": "phpstan-extension",
    "keywords": [
        "php",
        "phpstan",
        "phpstan-extension",
        "static-analysis",
        "code-style",
        "cognitive-complexity"
    ],
    "homepage": "https://github.com/gboquizosanchez/phpstan-code-limits",
    "authors": [
        {
            "name": "Germán Boquizo Sánchez",
            "email": "germanboquizosanchez@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "phpstan/phpstan": "^2.1",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Boquizo\\PHPStanCodeLimits\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/code-limits-install"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refactor": "rector",
        "lint": "pint",
        "test:refactor": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
